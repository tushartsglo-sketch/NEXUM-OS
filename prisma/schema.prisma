generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model KnowledgeEntry {
  id        String   @id @default(cuid())
  title     String
  type      String
  topic     String
  content   String
  tags      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Task {
  id          String   @id @default(cuid())
  title       String
  description String?
  date        DateTime
  time        String
  duration    Int
  status      String   @default("todo")
  priority    String   @default("medium")
  project     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String
  status      String   @default("active")
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model JournalEntry {
  id        String   @id @default(cuid())
  date      DateTime @unique
  did       String
  learned   String
  mistakes  String
  next      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ResearchProject {
  id          String   @id @default(cuid())
  title       String
  question    String
  status      String   @default("idea")
  notes       String   @default("")
  insights    String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  sources     ResearchSource[]
}

model ResearchSource {
  id          String         @id @default(cuid())
  title       String
  url         String
  notes       String         @default("")
  projectId   String
  project     ResearchProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
}

model ContentItem {
  id          String   @id @default(cuid())
  title       String
  format      String   @default("post")
  stage       String   @default("idea")
  body        String   @default("")
  sourceIdea  String   @default("")
  researchId  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LibraryFile {
  id          String   @id @default(cuid())
  name        String
  type        String
  url         String
  description String   @default("")
  tags        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InboxItem {
  id        String   @id @default(cuid())
  text      String
  status    String   @default("inbox")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
